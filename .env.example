# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Optional: if set, all /api routes (except the Shopify webhook) require header x-api-key
API_KEY=

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Recommended for the backend: bypasses RLS. NEVER expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Integrations (stubs run without these; real calls activate when set) ---
STRIPE_SECRET_KEY=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=recovery@example.com

# Commission paid to the rep on a recovered cart (0.15 = 15%)
COMMISSION_RATE=0.15
